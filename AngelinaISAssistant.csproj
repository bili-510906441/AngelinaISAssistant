<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RootNamespace>AngelinaISAssistant</RootNamespace>
    <AssemblyName>AngelinaISAssistant</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-ddTHH:mm:ss.fffffffzzz'))" />
  </ItemGroup>

  <!-- 窗口 / 任务栏图标（需要 pack URI，保持内嵌） -->
  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <!-- 黑流树海数据与图片：数据内嵌，图片作为外部文件按需加载 -->
  <ItemGroup>
  </ItemGroup>

  <!-- 实时辅助「敌人数值」内嵌数据（由 version_tools/generate_intel_data.py 从 tomimi.dev 生成） -->
  <ItemGroup>
    <EmbeddedResource Include="Live\Intel\data\*.json" />
  </ItemGroup>

  <!-- 地图与敌人头像：随程序输出到 Resources\ 目录，运行时按需读取 -->
  <ItemGroup>
  </ItemGroup>

  <!-- 许可证与第三方声明，随程序一起输出 -->
  <ItemGroup>
    <None Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 实时辅助 OCR 模型：随程序输出/发布到 models\ppocr -->
  <ItemGroup>
    <None Update="models\ppocr\PP-OCRv6_small_det.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="models\ppocr\PP-OCRv6_small_rec.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="models\ppocr\keys.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="models\ppocr\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>

    <!-- 小体积 GPU 方案：DirectML（约 37 MB），随发布包分发 -->
    <None Include="libs\onnxruntime_dml\onnxruntime.dll"
          Link="externals\onnxruntime_dml\onnxruntime.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="libs\onnxruntime_dml\onnxruntime_providers_shared.dll"
          Link="externals\onnxruntime_dml\onnxruntime_providers_shared.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="libs\onnxruntime_dml\DirectML.dll"
          Link="externals\onnxruntime_dml\DirectML.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="libs\onnxruntime_dml\*.txt"
          Link="externals\onnxruntime_dml\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 客户端只需要 hpatchz 应用补丁；hdiffz 在 new_structure\version_tools 里，随发布包不分发 -->
  <ItemGroup>
    <None Include="hdiffpatch_v5.1.3_bin_windows64\windows64\hpatchz.exe"
          Link="tools\hdiffpatch\hpatchz.exe"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="hdiffpatch_v5.1.3_bin_windows64\windows64\LICENSE.txt"
          Link="tools\hdiffpatch\LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DependencySetup_依赖库安装.bat"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试工程与工具目录位于仓库根，不参与主工程编译 -->
    <Compile Remove="auto_test\**" />
    <None Remove="auto_test\**" />
    <Page Remove="auto_test\**" />
    <ApplicationDefinition Remove="auto_test\**" />
    <Compile Remove="version_tools\**" />
    <None Remove="version_tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="libs\onnxruntime\*.dll"
          Link="onnxruntime\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="libs\onnxruntime\LICENSE.txt"
          Link="onnxruntime\LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="MoveExternals" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)externals" />
    <ItemGroup>
      <ExternalAssembly Include="$(PublishDir)Microsoft.Windows.SDK.NET.dll" Condition="Exists('$(PublishDir)Microsoft.Windows.SDK.NET.dll')" />
      <ExternalAssembly Include="$(PublishDir)WinRT.Runtime.dll" Condition="Exists('$(PublishDir)WinRT.Runtime.dll')" />
      <ExternalAssembly Include="$(PublishDir)Serilog.dll" Condition="Exists('$(PublishDir)Serilog.dll')" />
      <ExternalAssembly Include="$(PublishDir)Serilog.Sinks.File.dll" Condition="Exists('$(PublishDir)Serilog.Sinks.File.dll')" />
      <ExternalAssembly Include="$(PublishDir)Vortice.Direct3D11.dll" Condition="Exists('$(PublishDir)Vortice.Direct3D11.dll')" />
      <ExternalAssembly Include="$(PublishDir)Vortice.DXGI.dll" Condition="Exists('$(PublishDir)Vortice.DXGI.dll')" />
      <ExternalAssembly Include="$(PublishDir)Vortice.DirectX.dll" Condition="Exists('$(PublishDir)Vortice.DirectX.dll')" />
      <ExternalAssembly Include="$(PublishDir)Vortice.Mathematics.dll" Condition="Exists('$(PublishDir)Vortice.Mathematics.dll')" />
      <ExternalAssembly Include="$(PublishDir)SharpGen.Runtime.dll" Condition="Exists('$(PublishDir)SharpGen.Runtime.dll')" />
      <ExternalAssembly Include="$(PublishDir)SharpGen.Runtime.COM.dll" Condition="Exists('$(PublishDir)SharpGen.Runtime.COM.dll')" />
    </ItemGroup>
    <Move SourceFiles="@(ExternalAssembly)" DestinationFolder="$(PublishDir)externals" />

    <MakeDir Directories="$(PublishDir)externals" />
    <ItemGroup>
      <OnnxDll Include="$(PublishDir)onnxruntime\*.dll" />
      <OnnxLicense Include="$(PublishDir)onnxruntime\LICENSE.txt" />
    </ItemGroup>
    <Move SourceFiles="@(OnnxDll)" DestinationFolder="$(PublishDir)externals" />
    <Move SourceFiles="@(OnnxLicense)" DestinationFiles="$(PublishDir)externals\onnxruntime_LICENSE.txt" />
    <RemoveDir Directories="$(PublishDir)onnxruntime" />
  </Target>
</Project>
