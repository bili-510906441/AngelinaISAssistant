<Window x:Class="AngelinaISAssistant.MaskOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaskOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False"
        Focusable="False">

    <Grid>
        <!-- 识别结果层：坐标由后端给出（物理像素），这里换算成 DIP -->
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" />

        <!-- 左侧垂直居中：适配不同分辨率 -->
        <StackPanel x:Name="OverlayPanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    MaxWidth="420">
            <TextBlock x:Name="TitleText"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <StackPanel x:Name="LogPanel" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
