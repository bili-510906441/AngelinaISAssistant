<Window x:Class="AngelinaISAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="test"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        Icon="pack://application:,,,/AngelinaISAssistant;component/Resources/app.ico"
        Width="1000"
        Height="660"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- 顶部四个栏目 -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="8" Padding="18,9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置左侧快速跳转列表 -->
        <Style x:Key="SettingsNavStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsAdvancedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Padding="12,8" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 深色模式 / 开关 -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26">
                            <Border x:Name="Track" CornerRadius="13" Background="{DynamicResource SwitchOffBrush}" />
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Fill="{DynamicResource SwitchThumbBrush}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SwitchOffBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Root"
                                                CornerRadius="8"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="SelectionBox"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />

                            <TextBlock Text="&#xE70D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       IsHitTestVisible="False" />

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Margin="0,4,0,0"
                                        CornerRadius="8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主题选择卡片 -->
        <!-- 过滤标签 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 敌人情报表格（DataGrid） -->
        <Style x:Key="EnemyCellTextRight" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>

        <!-- 方形对勾框 -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1.5">
                                <Path x:Name="Check"
                                      Data="M 4,9 L 7.5,12.5 L 14,5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题下方：实时辅助 / 输出日志 / 设置 -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Str.TabLive}"
                                 Tag="0"
                                 IsChecked="True"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked" />
                    <RadioButton Content="{DynamicResource Str.TabLog}"
                                 Tag="1"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="TabSettings"
                                 Content="{DynamicResource Str.TabSettings}"
                                 Tag="2"
                                 Style="{StaticResource NavItemStyle}"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <!-- 右对齐：品牌名，版本不是最新时变彩虹色滚动 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateFailedText"
                               Text="{DynamicResource Str.Update.Failed}"
                               Margin="0,0,10,0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="#E5484D"
                               Visibility="Collapsed" />

                    <Border x:Name="BrandHitArea"
                            Background="Transparent"
                            MouseLeftButtonUp="Brand_Click">
                        <TextBlock x:Name="AngelinaBrand"
                                   Text="Angelina"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="Pages" Grid.Row="1" Margin="20">


            <!-- 1：实时辅助 -->
            <Grid Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Live.Title}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{DynamicResource Str.Live.Subtitle}" Style="{StaticResource BodyTextStyle}" />
                            <TextBlock x:Name="LiveBackendStatus"
                                       Text="{DynamicResource Str.Live.BackendUnavailable}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1"
                                      Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- 局外 -->
                                <TextBlock Text="{DynamicResource Str.Live.Group.Out}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}" />

                                <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="LiveRelicRecord"
                                              Content="{DynamicResource Str.Live.RelicRecord}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Margin="0,0,0,10"
                                              Checked="LiveOption_Changed"
                                              Unchecked="LiveOption_Changed" />
                                    <CheckBox x:Name="LiveStageValues"
                                              Content="{DynamicResource Str.Live.StageValues}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Checked="LiveOption_Changed"
                                              Unchecked="LiveOption_Changed" />
                                </StackPanel>

                                <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource BorderBrush}" />

                                <!-- 局内 -->
                                <TextBlock Text="{DynamicResource Str.Live.Group.In}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}" />

                                <StackPanel Margin="0,10,0,0">
                                    <CheckBox x:Name="LiveBattleAssist"
                                              Content="{DynamicResource Str.Live.BattleAssist}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Margin="0,0,0,10"
                                              Checked="LiveOption_Changed"
                                              Unchecked="LiveOption_Changed" />
                                    <CheckBox x:Name="LiveEnemyHealth"
                                              Content="{DynamicResource Str.Live.EnemyHealth}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Margin="0,0,0,10"
                                              Checked="LiveOption_Changed"
                                              Unchecked="LiveOption_Changed" />
                                    <CheckBox x:Name="LiveSpecialStage"
                                              Content="{DynamicResource Str.Live.SpecialStage}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Checked="LiveOption_Changed"
                                              Unchecked="LiveOption_Changed" />
                                </StackPanel>

                                <Border Height="1" Margin="0,18,0,18" Background="{DynamicResource BorderBrush}" />

                                <!-- 通用 -->
                                <TextBlock Text="{DynamicResource Str.Live.Group.Common}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                                <TextBlock Text="{DynamicResource Str.Live.None}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右上角：屏幕预览 -->
                <Border Grid.Column="1"
                        Width="380"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.Preview.Title}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="CaptureStatus"
                                       Text="{DynamicResource Str.Status.Idle}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}" />
                        </Grid>

                        <Border Margin="0,10,0,0"
                                Height="196"
                                CornerRadius="8"
                                Background="#0A0B0D"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" />

                                <!-- 右上角：实际采集帧率 -->
                                <Border x:Name="FpsBadge"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="8"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#A6000000"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="RealFpsText"
                                               Text="0 fps"
                                               FontSize="11"
                                               Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{DynamicResource Str.Preview.Fps}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubtleTextBrush}" />

                            <ComboBox x:Name="FpsCombo"
                                      Grid.Column="1"
                                      Width="120"
                                      Style="{StaticResource ComboBoxStyle}"
                                      SelectionChanged="Fps_SelectionChanged">
                                <ComboBoxItem Content="1 fps" Tag="1" />
                                <ComboBoxItem Content="5 fps" Tag="5" />
                                <ComboBoxItem Content="10 fps" Tag="10" />
                                <ComboBoxItem Content="30 fps" Tag="30" />
                            </ComboBox>
                        </Grid>

                        <Button x:Name="CaptureToggleButton"
                                Content="{DynamicResource Str.Capture.Start}"
                                Margin="0,12,0,0"
                                Height="36"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="CaptureToggle_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2：输出日志 -->
            <Border Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str.Log.Title}" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{DynamicResource Str.Log.Subtitle}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,16,0,0"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="12">
                        <ListBox x:Name="LogList"
         Background="Transparent"
         BorderThickness="0"
         Padding="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Line}"
                       FontFamily="Consolas, Courier New"
                       FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter Property="Foreground" Value="#5BE37D" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Foreground" Value="#F5C451" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Foreground" Value="#FF6B6B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </ListBox.ItemTemplate>
</ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 3：设置 -->
            <Border Style="{StaticResource CardStyle}" Padding="0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="248" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：搜索框 + 快速跳转 -->
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource Str.Settings.Title}" Style="{StaticResource SectionTitleStyle}" />

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">

                                <Border CornerRadius="8"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Height="36"
                                        Padding="8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SubtleTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0" />

                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="SearchPlaceholder"
                                                       Text="{DynamicResource Str.Settings.Search}"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                            <TextBox x:Name="SettingsSearch"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     CaretBrush="{DynamicResource TextBrush}"
                                                     TextChanged="SettingsSearch_TextChanged" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel x:Name="SettingsNav" Margin="0,12,0,0">
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.Connection}"
                                                 Tag="0"
                                                 IsChecked="True"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton x:Name="SettingsNavUpdate"
                                                 Content="{DynamicResource Str.SettingsNav.Update}"
                                                 Tag="1"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.Appearance}"
                                                 Tag="2"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.Language}"
                                                 Tag="3"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.Achievements}"
                                                 Tag="4"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.Feedback}"
                                                 Tag="5"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton Content="{DynamicResource Str.SettingsNav.About}"
                                                 Tag="6"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton x:Name="SettingsNavPerformance"
                                                 Content="{DynamicResource Str.SettingsNav.Performance}"
                                                 Tag="7"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                    <RadioButton x:Name="SettingsNavHotkeys"
                                                 Content="{DynamicResource Str.SettingsNav.Hotkeys}"
                                                 Tag="8"
                                                 Style="{StaticResource SettingsNavStyle}"
                                                 Checked="SettingsNav_Checked" />
                                </StackPanel>

                                <Button x:Name="AdvancedToggleButton"
                                        Content="{DynamicResource Str.Advanced.Show}"
                                        Style="{StaticResource SettingsAdvancedButtonStyle}"
                                        Click="AdvancedToggle_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右：内容 -->
                    <ScrollViewer x:Name="SettingsScroll"
                                  Grid.Column="1"
                                  Padding="24"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="SettingsScroll_ScrollChanged">
                        <StackPanel x:Name="SettingsSections">

                            <!-- 连接设置 -->
                            <StackPanel x:Name="SectionConnection">
                                <TextBlock Text="{DynamicResource Str.Connection.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Connection.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="{DynamicResource Str.Capture.BackendLabel}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="CaptureBackendRow"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.Capture.Hint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <ComboBox x:Name="CaptureBackendCombo"
                                                  Grid.Column="1"
                                                  Width="225"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  SelectionChanged="CaptureBackend_SelectionChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 更新设置 -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionUpdate">
                                <TextBlock Text="{DynamicResource Str.Update.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Update.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <Border x:Name="AutoUpdateRow"
                                        Margin="0,20,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Update.Auto}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{DynamicResource Str.Update.AutoHint}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SubtleTextBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  x:Name="AutoUpdateSwitch"
                                                  VerticalAlignment="Center"
                                                  IsChecked="True"
                                                  Style="{StaticResource ToggleSwitchStyle}" />
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="UpdateStatusText"
                                           Text="{DynamicResource Str.Update.LastCheck}"
                                           Margin="0,16,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}" />

                                <TextBlock Text="{DynamicResource Str.Update.Mode}"
                                           Style="{StaticResource FieldLabelStyle}" />

                                <StackPanel x:Name="UpdateModeRow" Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str.Update.Mode.Diff}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" />

                                    <CheckBox x:Name="UpdateModeSwitch"
                                              Margin="16,0"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Checked="UpdatePreference_Checked"
                                              Unchecked="UpdatePreference_Checked" />

                                    <TextBlock Text="{DynamicResource Str.Update.Mode.Full}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextBrush}" />
                                </StackPanel>

                                <Button x:Name="CheckUpdateButton"
                                        Content="{DynamicResource Str.Update.CheckNow}"
                                        Margin="0,16,0,0"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="CheckUpdate_Click" />

                                <Button x:Name="ApplyUpdateButton"
                                        Content="{DynamicResource Str.Update.Apply}"
                                        Margin="0,10,0,0"
                                        Height="38"
                                        HorizontalAlignment="Left"
                                        Visibility="Collapsed"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="ApplyUpdate_Click" />

                                <TextBlock x:Name="UpdateProgressText"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>

                            <!-- 外观设置 -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionAppearance">
                                <TextBlock Text="{DynamicResource Str.Appearance.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Appearance.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="{DynamicResource Str.Appearance.Theme}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="DarkModeRow"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Str.Theme.LightShort}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" />

                                            <CheckBox x:Name="DarkModeSwitch"
                                                      Margin="16,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                      Checked="DarkMode_Toggled"
                                                      Unchecked="DarkMode_Toggled" />

                                            <TextBlock Text="{DynamicResource Str.Theme.DarkShort}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                </Border>

                                <Border x:Name="AlwaysOnTopRow"
                                        Margin="0,12,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Appearance.AlwaysOnTop}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{DynamicResource Str.Appearance.AlwaysOnTopHint}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource SubtleTextBrush}" />
                                        </StackPanel>

                                        <CheckBox x:Name="AlwaysOnTopSwitch"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="AlwaysOnTop_Toggled"
                                                  Unchecked="AlwaysOnTop_Toggled" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Str.Appearance.Note}"
                                           FontSize="12"
                                           Margin="0,12,0,0"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>



<!-- 语言设置 -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionLanguage">
                                <TextBlock Text="{DynamicResource Str.Language.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Language.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="{DynamicResource Str.Language.Label}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="LanguageRow"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.Language.Hint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <ComboBox x:Name="LanguageCombo"
                                                  Grid.Column="1"
                                                  Width="150"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  SelectionChanged="Language_SelectionChanged">
                                            <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                            <ComboBoxItem Content="繁體中文" Tag="zh-TW" />
                                            <ComboBoxItem Content="English" Tag="en-US" />
                                            <ComboBoxItem Content="日本語" Tag="ja-JP" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 成就设置（内容待补充） -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionAchievements">
                                <TextBlock Text="{DynamicResource Str.Achievements.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Achievements.Subtitle}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Text="{DynamicResource Str.Achievements.Placeholder}"
                                           Margin="0,16,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>

                            <!-- 问题反馈 -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionFeedback">
                                <TextBlock Text="{DynamicResource Str.Feedback.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Feedback.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <Border x:Name="FeedbackRow"
                                        Margin="0,20,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.Feedback.Hint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="{DynamicResource Str.Feedback.Faq}"
                                                    Height="34"
                                                    Padding="18,0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="FeedbackFaq_Click" />

                                            <Button Content="{DynamicResource Str.Feedback.Issues}"
                                                    Height="34"
                                                    Margin="10,0,0,0"
                                                    Padding="18,0"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="FeedbackIssues_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 关于 -->
                            <Border Height="1" Margin="0,28,0,28" Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionAbout">
                                <TextBlock Text="{DynamicResource Str.About.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.About.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <Border x:Name="AboutRow"
                                        Margin="0,20,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock x:Name="PlatformText" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock x:Name="RuntimeText" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock Text="{DynamicResource Str.About.Build}" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>

<TextBlock Margin="0,14,0,0" FontSize="13">
                                    <Hyperlink NavigateUri="https://space.bilibili.com/510906441"
                                               Foreground="{DynamicResource AccentBrush}"
                                               RequestNavigate="Link_RequestNavigate">bilibili</Hyperlink>
                                    <Run Text="  ·  " Foreground="{DynamicResource SubtleTextBrush}" />
                                    <Hyperlink NavigateUri="https://github.com/bili-510906441/AngelinaISAssistant"
                                               Foreground="{DynamicResource AccentBrush}"
                                               RequestNavigate="Link_RequestNavigate">GitHub</Hyperlink>
                                </TextBlock>

                            </StackPanel>

<!-- 性能设置（高级设置，默认隐藏） -->
                            <Border x:Name="PerformanceDivider"
                                    Height="1"
                                    Margin="0,28,0,28"
                                    Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionPerformance">
                                <TextBlock Text="{DynamicResource Str.Performance.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Performance.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <TextBlock Text="{DynamicResource Str.Performance.GpuLabel}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="InferenceGpuRow"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.Performance.GpuHint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <ComboBox x:Name="InferenceGpuCombo"
                                                  Grid.Column="1"
                                                  Width="240"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  SelectionChanged="InferenceGpu_SelectionChanged" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource Str.Performance.SoftwareLabel}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="SoftwareRenderRow"
                                        Margin="0,12,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.Performance.SoftwareHint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <CheckBox x:Name="SoftwareRenderSwitch"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource CheckBoxStyle}"
                                                  Checked="SoftwareRender_Toggled"
                                                  Unchecked="SoftwareRender_Toggled" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Str.NumberFormat.Label}" Style="{StaticResource FieldLabelStyle}" />

                                <Border x:Name="NumberFormatRow"
                                        Margin="0,12,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{DynamicResource Str.NumberFormat.Hint}"
                                                   FontSize="12"
                                                   Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SubtleTextBrush}" />

                                        <ComboBox x:Name="NumberFormatCombo"
                                                  Grid.Column="1"
                                                  Width="240"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  SelectionChanged="NumberFormat_SelectionChanged" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <!-- 热键设置（高级设置，默认隐藏） -->
                            <Border x:Name="HotkeyDivider"
                                    Height="1"
                                    Margin="0,28,0,28"
                                    Background="{DynamicResource BorderBrush}" />
                            <StackPanel x:Name="SectionHotkeys">
                                <TextBlock Text="{DynamicResource Str.Hotkey.Title}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{DynamicResource Str.Hotkey.Subtitle}" Style="{StaticResource BodyTextStyle}" />

                                <Border x:Name="HotkeyRow"
                                        Margin="0,20,0,0"
                                        CornerRadius="10"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str.Hotkey.ShowHideLabel}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{DynamicResource Str.Hotkey.Hint}"
                                                       Margin="0,4,0,0"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SubtleTextBrush}" />
                                        </StackPanel>

                                        <TextBox x:Name="HotkeyBox"
                                                 Grid.Column="1"
                                                 Width="225"
                                                 VerticalAlignment="Center"
                                                 IsReadOnly="True"
                                                 Focusable="True"
                                                 Cursor="Hand"
                                                 TextAlignment="Center"
                                                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                            
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
