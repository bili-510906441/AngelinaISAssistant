<Window x:Class="AngelinaISAssistant.CrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Crash.Title}"
        Icon="pack://application:,,,/AngelinaISAssistant;component/Resources/app.ico"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentBrush}" />

        <TextBlock x:Name="ReasonText"
                   Grid.Row="1"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   Foreground="{DynamicResource TextBrush}" />

        <TextBlock x:Name="GuideText"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   LineHeight="21"
                   Foreground="{DynamicResource SubtleTextBrush}" />

        <TextBox x:Name="ReportPathText"
                 Grid.Row="3"
                 Margin="0,12,0,0"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="False"
                 BorderThickness="0"
                 Background="Transparent"
                 TextWrapping="Wrap"
                 FontFamily="Consolas, Courier New"
                 FontSize="12"
                 Foreground="{DynamicResource SubtleTextBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OpenFolderButton"
                    Content="{DynamicResource Str.Crash.OpenFolder}"
                    Height="34"
                    Style="{StaticResource DialogSecondaryButton}"
                    Click="OpenFolder_Click" />
            <Button Content="{DynamicResource Str.Crash.Close}"
                    Height="34"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    IsCancel="True"
                    Style="{StaticResource DialogPrimaryButton}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
