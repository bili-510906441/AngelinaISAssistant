<Window x:Class="AngelinaISAssistant.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Notice.Title}"
        Icon="pack://application:,,,/AngelinaISAssistant;component/Resources/app.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="NoticeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock x:Name="HeadlineText"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentBrush}" />

        <TextBlock x:Name="MessageText"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   Foreground="{DynamicResource TextBrush}" />

        <TextBlock x:Name="DetailText"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   FontSize="12"
                   Foreground="{DynamicResource SubtleTextBrush}" />

        <Button Content="{DynamicResource Str.Notice.Close}"
                Margin="0,20,0,0"
                Height="34"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Padding="18,0"
                Style="{StaticResource NoticeButtonStyle}" />
    </StackPanel>
</Window>
